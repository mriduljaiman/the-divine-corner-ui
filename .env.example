# Copy this to .env.local for local development
# In Vercel: set these in Project Settings → Environment Variables

# Backend API URL
# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:8080/api
# Production (update after deploying backend on Render):
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com/api

# Cloudinary (for image uploads)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Tawk.to Live Chat
# Sign up at https://www.tawk.to → Add Property → copy the Property ID from the embed script
NEXT_PUBLIC_TAWK_PROPERTY_ID=your_property_id_here
# Widget ID is usually "default" unless you created a named widget
NEXT_PUBLIC_TAWK_WIDGET_ID=default
